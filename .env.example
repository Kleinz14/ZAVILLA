# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXCHANGERATE_API_KEY: Server-side key from https://www.exchangerate-api.com/
# Never expose this as a VITE_ variable or commit the real key.
EXCHANGERATE_API_KEY="YOUR_EXCHANGERATE_API_KEY"

# Flutterwave — powers the agent subscription payments (/api/payments/*).
# FLW_SECRET_KEY is the only one the backend code actually calls Flutterwave
# with; the FLW_PLAN_* IDs come from Payment Plans you create in your
# Flutterwave dashboard (Settings > Payment Plans) — one per tier, billed
# monthly. Until a plan's ID is set here, that tier is disabled (the
# /api/payments/plans endpoint reports it as "configured": false).
FLW_SECRET_KEY="YOUR_FLUTTERWAVE_TEST_SECRET_KEY"
FLW_PUBLIC_KEY="YOUR_FLUTTERWAVE_TEST_PUBLIC_KEY"
FLW_ENCRYPTION_KEY="YOUR_FLUTTERWAVE_TEST_ENCRYPTION_KEY"
FLW_WEBHOOK_HASH="YOUR_FLUTTERWAVE_TEST_WEBHOOK_HASH"
FLW_PLAN_ESSENTIAL="YOUR_FLUTTERWAVE_ESSENTIAL_PLAN_ID"
FLW_PLAN_PROFESSIONAL="YOUR_FLUTTERWAVE_PROFESSIONAL_PLAN_ID"
FLW_PLAN_SIGNATURE="YOUR_FLUTTERWAVE_SIGNATURE_PLAN_ID"
ADMIN_EMAIL="YOUR_ADMIN_EMAIL"

# --- Backend auth ---------------------------------------------------------

# PORT: port the Express backend listens on locally.
PORT=3001

# JWT_SECRET: signs and verifies login tokens. REQUIRED in production —
# generate one with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="replace-with-a-long-random-string"

# JWT_EXPIRES_IN: how long a login session lasts.
JWT_EXPIRES_IN="7d"

# NODE_ENV: set to "production" when deployed so auth cookies require HTTPS.
NODE_ENV="development"
